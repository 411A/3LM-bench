[
 {
  "id": "devops/0",
  "source": "hand-authored/FDE-Bench-lineage",
  "category": "devops",
  "lang": "dockerfile-fastapi",
  "prompt": "Write a Dockerfile that runs a FastAPI app on port 8000, as a non-root user, with a healthcheck. Output only Dockerfile content.",
  "checks": {
   "must_contain": [
    "FROM",
    "EXPOSE 8000",
    "USER",
    "HEALTHCHECK"
   ],
   "must_not_contain": [
    "USER root",
    "privileged"
   ],
   "lang": "dockerfile"
  }
 },
